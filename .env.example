# Скопируйте этот файл в .env и при необходимости измените значения.
# .env не коммитится и не попадает в Docker-образ.
WEATHER_CITY=Yakutsk
WEATHER_LAT=62.01436
WEATHER_LON=129.7124
WEATHER_TIMEZONE=Asia/Yakutsk

# Контакт для User-Agent MET Norway (по правилам API обязателен).
WEATHER_CONTACT_EMAIL=you@example.com

WEATHER_INTERVAL_MIN=30
WEATHER_PLOT_EVERY=5
WEATHER_TIMEOUT_SEC=15
WEATHER_CURRENT_MAX_AGE_HOURS=6
WEATHER_FORECAST_MAX_AGE_HOURS=3

# Необязательно: путь к SQLite (по умолчанию data/weather.db).
# WEATHER_DB_PATH=data/weather.db
# WEATHER_PLOTS_DIR=data/plots
